CREATE TABLE directory_folders(
    uri TEXT NOT NULL PRIMARY KEY,
    viewer_flags INTEGER NOT NULL
);

getViewerFlags:
SELECT viewer_flags
FROM directory_folders
WHERE uri = :uri;

setViewerFlags:
INSERT INTO directory_folders(uri, viewer_flags)
VALUES (:uri, :flag & :mask)
ON CONFLICT(uri) DO UPDATE SET
    viewer_flags = (viewer_flags & ~:mask) | excluded.viewer_flags;
